# ─── Production Environment Variables ────────────────────────────────────────

# Google Sheets Web App URL
NEXT_PUBLIC_WEBAPP_URL=https://script.google.com/macros/s/AKfycbwNrxNFSiWcdl5dX1I1AyeYcrIPprzxP_A3srrzNj-XA8dwUognh8y8r7gBEUrFDaOFgA/exec

# App Configuration
NEXT_PUBLIC_APP_NAME=3EJS Tech

# Data Source (use "sheets" for production)
DATA_SOURCE=sheets

# Session secret used to sign auth cookies in production (next start / Electron).
# Change this to a long random value. The Electron build generates its own
# per-install secret automatically, so this is only needed for web deploys.
SESSION_SECRET=58e02050ea49b5eddbbd7e2568b69088bdbb01df2409d1705f7b68551579788d